  "strings": {
    "媒体识别失败，点按重试": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to identify media. Tap to retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "媒体识别失败，点按重试"
          }
        }
      }
    },
    "视频加载超时，请检查网络后重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video loading timed out. Check your connection and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频加载超时，请检查网络后重试。"
          }
        }
      }
    },
    "无权访问此视频，请重新登录后重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You do not have access to this video. Sign in again and retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无权访问此视频，请重新登录后重试。"
          }
        }
      }
    },
    "视频文件不存在或已失效。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This video is missing or no longer available."
