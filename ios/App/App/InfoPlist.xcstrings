{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "imimchat uses the camera for video calls, QR scanning, Moments photos, and avatars."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "imimchat 需要使用摄像头，以便您在视频通话、扫一扫、拍摄朋友圈和更换头像时使用。"
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "imimchat can use your contacts to find people you may know. You can disable access in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "imimchat 可以通过您的通讯录匹配可能认识的好友，您可以随时在设置中关闭。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "imimchat uses Face ID to protect your account and encrypted chats through on-device identity verification."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "imimchat 使用 Face ID 保护您的账号与加密聊天内容，仅用于本机身份校验。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "imimchat uses direct connections on your local network to improve call quality."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "imimchat 在同一局域网内进行音视频通话直连以提升通话质量。"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "imimchat uses background location for live location sharing and location history. You can disable access in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "imimchat 需要在后台持续获取位置，以便进行实时位置共享与位置轨迹记录。如您不需要后台定位，可随时在设置中关闭。"
          }
        }
      }
    },
    "NSLocationAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "imimchat uses background location for live location sharing and location history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "imimchat 需要在后台持续获取位置，以便进行实时位置共享与位置轨迹记录。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "imimchat uses your location to share locations and send location messages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "imimchat 需要在您使用 App 时获取位置，以便共享位置、发送位置消息及基于位置的聊天功能。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "imimchat uses the microphone for voice and video calls, voice messages, and AI voice conversations you explicitly start."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "imimchat 使用麦克风进行音视频通话、发送语音消息，以及您主动开启的 AI 语音对话。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "imimchat saves photos and videos from chats to your photo library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "imimchat 需要将聊天中收到的图片/视频保存到您的相册。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "imimchat accesses your photo library to select photos and videos for chats, Moments, and avatars."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "imimchat 需要访问您的相册，以便选择图片/视频作为聊天内容或头像。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "imimchat uses on-device speech recognition to turn your AI voice conversation into text. Only text you consent to share is sent to DeepSeek; recordings are not uploaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "imimchat 使用本机语音识别，将您在 AI 语音对话中说的话转为文字；仅经您同意的文字会发送给 DeepSeek，不上传录音。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
